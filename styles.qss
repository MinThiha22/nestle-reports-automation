#title {
  font-weight: bold; border: none;
}
#container_top{
            padding: 10px; 
}
#container{
            padding: 5px; 
            border-radius: 5px; 
            border: 1px solid gray;
}

#status_label {
  background-color: rgb(54, 54, 54);
  color:rgb(131, 107, 208);;
  border-radius:5px;
  padding:5px;
}

#step_btn {
            background-color:rgb(82, 51, 183); 
            color: white; 
            border: 1px solid gray; 
            width: 100px;
            padding: 5px 5px; 
            text-align: center; 
            text-decoration: none; 
            display: inline-block; 
            font-size: 12px; 
            border-radius: 5px;
        }
#step_btn:hover {
            background-color:rgb(55, 35, 122); 
        }

#step3_btn {
            background-color: rgb(207, 52, 141); 
            color: white; 
            border: none; 
            width:150px;
            max-width:150px;
            padding: 5px 5px; 
            text-align: center; 
            text-decoration: none; 
            display: inline-block; 
            font-size: 10px; 
            border-radius: 5px;
        }
#step3_btn:hover {
            background-color:rgb(124, 34, 85);
        }


#error_overlay {
    background-color: #ff6b6b;
    border: 3px solid #e90101ff;
    border-radius: 10px;
    box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.3);
}

#error_message {
    color: #2d3436;
    padding: 8px;
}

#close_btn {
    background-color: #636e72;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
}
#close_btn:hover {
    background-color: #2d3436;
}
